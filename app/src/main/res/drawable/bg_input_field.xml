<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗内的输入框：容器色底 + 圆角，聚焦时描边换成主色，让「正在输入」有明确反馈 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</selector>
